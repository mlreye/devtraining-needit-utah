        <script><![CDATA[(function executeRule(current, previous /*null when async*/) {
	
	//will contain the list of Incident numbers
	var duplicates = [];

	//Description = current one, incident is active, and current one is not picked
	var gr = new GlideRecord('incident');
	gr.addQuery('short_description', current.short_description);
	gr.addQuery('active', true);
	gr.addQuery('sys_id', '!=', current.sys_id);
	gr.query();

	//We fill the list 
	while (gr.next()) {
		duplicates.push(gr.number.toString());
	}

	//we display it
	if (duplicates.length > 0) {
		gs.addInfoMessage('Similar active incidents found: ' + duplicates.join(', '));
	}

})(current, previous);]]></script>
